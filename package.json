{
  "name": "vn-bakes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:visify": "VITE_APP_TARGET=visify VITE_BASE_PATH=/ vite --open /visify/",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:pages": "VITE_BASE_PATH=/vn-bakes/ vite build",
    "deploy:pages": "npm run build:pages && gh-pages -d dist",
    "build:visify": "VITE_APP_TARGET=visify VITE_BASE_PATH=/visify-desk/ vite build && node scripts/flatten-visify-dist.mjs",
    "deploy:visify": "npm run build:visify && gh-pages -d dist-visify -r https://github.com/visify-apps/visify-desk.git -b gh-pages"
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
